<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sssc</groupId>
        <artifactId>sssc-processors</artifactId>
        <version>1</version>
    </parent>

    <artifactId>nifi-customlistazureblobstorage-nar</artifactId>
    <version>1</version>
    <packaging>nar</packaging>

    <dependencies>
        <dependency>
            <groupId>sssc</groupId>
            <artifactId>nifi-customlistazureblobstorage-processors</artifactId>
            <version>1</version>
        </dependency>

        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-azure-processors</artifactId>
            <version>2.5.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-standard-services-api-nar</artifactId>
            <version>2.5.0</version>
            <type>nar</type>
            <scope>provided</scope>
        </dependency>

    <dependency>
        <groupId>org.apache.nifi</groupId>
        <artifactId>nifi-azure-services-api</artifactId>
        <version>2.5.0</version>
        <scope>provided</scope>
    </dependency>

 <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
            <scope>provided</scope>
     </dependency>
    </dependencies>

<build>
    <plugins>
        <plugin>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-nar-maven-plugin</artifactId>
            <version>2.2.0</version>
            <extensions>true</extensions>
            <configuration>
                <parentNarGroupId>org.apache.nifi</parentNarGroupId>
                <parentNarArtifactId>nifi-azure-nar</parentNarArtifactId>
                <parentNarVersion>2.5.0</parentNarVersion>
                
                <archive>
                    <manifestEntries>
                        <Nar-Dependency-Group>org.apache.nifi</Nar-Dependency-Group>
                        <Nar-Dependency-Id>nifi-azure-nar</Nar-Dependency-Id>
                        <Nar-Dependency-Version>2.5.0</Nar-Dependency-Version>
                    </manifestEntries>
                </archive>
            </configuration>
        </plugin>
    </plugins>
</build>
</project>